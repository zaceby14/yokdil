{
 "decisionTree": {
  "title": "Boşlukta ne arıyorum?",
  "nodes": [
   {
    "id": "n1",
    "q": "Şıklara bak: ne soruluyor?",
    "options": [
     {
      "label": "Bağlaç / edat karışık",
      "next": "n2"
     },
     {
      "label": "Fiil biçimleri (tense)",
      "next": "n3"
     },
     {
      "label": "which / that / whose / where",
      "result": "Virgül ya da edat varsa **which**; sonrası tam cümle → **where/when**; sonrası isim → **whose**."
     },
     {
      "label": "Ving / to V / V1",
      "next": "n4"
     },
     {
      "label": "Kelimeler",
      "result": "Anlam + eşdizim: boşluğun iki yanındaki kelimeye bak."
     }
    ]
   },
   {
    "id": "n2",
    "q": "Boşluktan sonra ne var?",
    "options": [
     {
      "label": "Özne + fiil (tam cümle)",
      "result": "Bağlaç: although / because / when / if… Sonra anlam: iki taraf aynı yön mü, ters mi?"
     },
     {
      "label": "İsim / Ving (fiil yok)",
      "result": "Edat: despite / due to / instead of / by…"
     },
     {
      "label": "V1",
      "result": "in order to / so as to"
     },
     {
      "label": "; ---- , ya da . ---- ,",
      "result": "Geçiş zarfı: however / therefore / moreover…"
     }
    ]
   },
   {
    "id": "n3",
    "q": "Zaman ifadesi var mı? (since, by, ago, over the past)",
    "options": [
     {
      "label": "Evet",
      "result": "İfadeye uy: since → have V3 · by the time + past → had V3 · ago → V2"
     },
     {
      "label": "Hayır",
      "result": "Diğer fiilin zamanına bak; o da yoksa genel gerçek = Present."
     }
    ]
   },
   {
    "id": "n4",
    "q": "Boşluktan önce ne var?",
    "options": [
     {
      "label": "Edat (of, by, without, to=edat)",
      "result": "Ving"
     },
     {
      "label": "enable / allow / cause + nesne",
      "result": "to V"
     },
     {
      "label": "let / make + nesne",
      "result": "V1"
     }
    ]
   }
  ]
 },
