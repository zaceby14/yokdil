  }
 ],
 "eliminationTips": [
  {
   "title": "1. Yapıyı ele",
   "text": "Boşluktan sonra tam cümle varsa edatları ele.",
   "ex": "---- the heat, … → despite (isim)"
  },
  {
   "title": "2. Kutbu bul",
   "text": "İki taraf ters yöndeyse aynı yön bağlaçlarını ele."
  },
  {
   "title": "3. Zamanı eşle",
   "text": "Zaman ifadesine uymayan fiil biçimlerini ele."
  }
 ],
 "personalRules": [
  {
   "topic": "edat-esdizim",
   "rule": "Değer → AT: at 100 °C, at a rate of",
   "ex": "at high speed",
   "wrong": "in 100 °C",
   "right": "at 100 °C"
  },
  {
   "topic": "baglac-zitlik",
   "rule": "Although (+), (−). Aynı yönse although ✗",
   "ex": "Although cheap, it is strong.",
   "wrong": "Although cheap, it is weak.",
   "right": "Because cheap, …"
  },
  {
   "topic": "baglac-neden-amac",
   "rule": "\"to\" testi: sonrasına isim gelirse Ving",
   "ex": "with a view to reducing",
   "wrong": "with a view to reduce",
   "right": "with a view to reducing"
  },
  {
   "topic": "relative",
   "rule": "Virgül veya edat → which",
   "ex": "…, which is…",
   "wrong": ", that",
   "right": ", which"
  }
 ],
