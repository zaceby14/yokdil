 "grammarNotes": [
  {
   "topic": "edat-esdizim",
   "rule": "temperature, rate, speed, level, pressure (+ sayı) → AT. Çeviri yapma, edatı işaretle geç.",
   "ex": "Water boils at a temperature of 100 °C. / It grows at a rate of 2% a year."
  },
  {
   "topic": "baglac-zitlik",
   "rule": "Although / while / whereas görünce sadece olumlu-olumsuz değil, ZAMAN zıtlığı da ara: yeni ↔ eski, genç ↔ antik.",
   "ex": "Although geology is a young science, its roots go back to ancient Greece."
  },
  {
   "topic": "baglac-zitlik",
   "rule": "While, even though, whereas cümle başında da gelir: 'While X ..., Y ...' = X iken/oysa Y. Virgülden sonra zıt kutbu ara.",
   "ex": "While coal is cheap, it is highly polluting."
  },
  {
   "topic": "yakin-anlam",
   "rule": "Restatement: kökteki ana bağlacın karşılığını şıklarda ara (while/although ↔ however, but, yet).",
   "ex": "While A, B. ≈ A; however, B."
  },
  {
   "topic": "baglac-neden-amac",
   "rule": "in order to / so as to + V1; with a view to / with the aim of + Ving (to burada edat).",
   "ex": "in order to reduce costs = with a view to reducing costs"
  },
  {
   "topic": "edat-esdizim",
   "rule": "lead to + isim / Ving (to edattır, yalın fiil gelmez). Aynı aile: contribute to, give rise to.",
   "ex": "Stress can lead to losing sleep. / Heat leads to expansion."
  },
  {
   "topic": "gerund-infinitive",
   "rule": "mean + Ving = anlamına gelmek; mean + to V = niyetinde olmak, kastetmek.",
   "ex": "Saving energy means using less. / I meant to call you."
  },
  {
   "topic": "gerund-infinitive",
   "rule": "with + isim + Ving (aktif, eşzamanlı) / with + isim + V3 (pasif). begin/start → to V veya Ving.",
   "ex": "With prices rising, demand fell. / With the work finished, they left."
  },
  {
   "topic": "either-neither",
   "rule": "either ... or (ya ... ya da), neither ... nor (ne ... ne de, fiil olumlu), both ... and (çoğul fiil). Fiil yakın özneye uyar.",
   "ex": "Neither the pump nor the valves were damaged."
  },
  {
   "topic": "relative",
   "rule": "which ↔ that: virgülden sonra ve edattan sonra THAT kullanılmaz (, which / in which). the only/the first/superlative/all sonrası that tercih edilir.",
   "ex": "Iron, which rusts, ... / the temperature at which ... / the only metal that ..."
  },
  {
   "topic": "ilgisiz",
   "rule": "İlgisiz cümle: konu (ör. yangın → sel) ya da kutup (neden kullanılır → eleştirilir) aniden kayıyorsa o cümle atılır.",
   "ex": "Yangın tahmini anlatılırken 'sel ve kuraklık' cümlesi → ilgisiz."
  },
  {
   "topic": "kelime",
   "rule": "Kelime öğrenirken yanındaki edatı da yaz (consist of, depend on, resistant to); kelimeleri tür (isim/fiil/sıfat/zarf/bağlaç) gruplarıyla çalış, cümlede kullan.",
   "ex": "rely on, focus on, attribute A to B"
  }
 ],
